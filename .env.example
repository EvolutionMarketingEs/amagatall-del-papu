# Copia este fichero como .env.local para desarrollo (Next.js lo carga solo).
# En producción, define estas mismas variables en el panel de tu hosting
# (Railway, Render, etc.) — nunca las escribas en el código.

# --- Email de aviso de reservas (Resend) ---
# Crea una cuenta gratuita en https://resend.com, genera una API key y pégala aquí.
RESEND_API_KEY=

# Dirección a la que llega el aviso de cada nueva reserva.
NOTIFICATION_EMAIL=

# Remitente del email. Con el dominio de prueba de Resend puedes dejar
# "onboarding@resend.dev" mientras no verifiques vuestro propio dominio.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Panel de administración (/admin) ---
# Usuario y contraseña para ver y exportar las reservas recibidas.
ADMIN_USER=
ADMIN_PASSWORD=

# --- Base de datos ---
# Carpeta donde se guarda el fichero SQLite de reservas. Solo hace falta
# tocarla si tu hosting exige un volumen persistente en otra ruta.
DATA_DIR=./data

# --- Contacto público mostrado en el footer ---
NEXT_PUBLIC_CONTACT_EMAIL=
